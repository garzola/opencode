{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    "default_agent": "build",
    "disabled_providers": [],
    "username": "Gustavo",
    "agent": {
        "plan": {
            "model": "gemma4:e4b"
        },
        "general": {
            "model": "ollama/nemotron-cascade-2:30b"
        },
        "build": {
            "model": "ollama/gemma4:31b"
        }
    },
    "enabled_providers": [
        "ollama"
    ],
    "instructions": [
        "AGENTS.md",
        "rules/*.md",
    ],
    "mcp": {
        "context7": {
            "enabled": true,
            "headers": {
                "CONTEXT7_API_KEY": "ctx7sk-8a37a0e0-a193-40c0-8a6f-ee35468b7d35"
            },
            "type": "remote",
            "url": "https://mcp.context7.com/mcp"
        },
        "excel": {
            "command": [
                "uvx",
                "excel-mcp-server",
                "stdio"
            ],
            "enabled": true,
            "type": "local"
        },
        "fetch": {
            "command": [
                "mcp-server-fetch"
            ],
            "enabled": true,
            "type": "local"
        },
        "filesystem": {
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "/home/gustavo/.config/opencode/",
                "/home/gustavo/.opencode/",
                "/home/gustavo/depots/worktrees/",
                "/home/gustavo/depots/gitlab/",
                "/home/gustavo/proj/"
            ],
            "enabled": true,
            "type": "local"
        },
        "sequential-thinking": {
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "enabled": true,
            "type": "local"
        }
    },
    "model": "glm-4.7-flash:q8_0",
    "provider": {
        "ollama": {
            "models": {
